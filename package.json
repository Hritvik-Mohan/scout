{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "profile:validate": "node dist/commands/validate-profile.js",
    "profile:score": "node dist/commands/score-opportunity.js",
    "jobs:sheet:create": "npm run build && node --env-file=.env dist/commands/create-job-sheet.js",
    "jobs:sheet:init": "npm run build && node --env-file=.env dist/commands/initialize-job-sheet.js",
    "jobs:run": "npm run build && node --env-file=.env dist/commands/run-job-scout.js",
    "jobs:update": "npm run jobs:run",
    "jobs:review:pending": "npm run build && node --env-file=.env dist/commands/list-pending-job-reviews.js",
    "jobs:review:apply": "npm run build && node --env-file=.env dist/commands/apply-job-reviews.js",
    "jobs:digest": "npm run build && node --env-file=.env dist/commands/job-digest.js",
    "jobs:companies": "npm run build && node --env-file=.env dist/commands/run-company-scout.js",
    "jobs:import:lets-code": "npm run build && node --env-file=.env dist/commands/import-lets-code-workbook.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^11.1.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
