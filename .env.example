NODE_ENV=development
DRY_RUN=true
TIMEZONE=Asia/Kolkata

# Default profile used by your own runner or automation.
SCOUT_PROFILE_PATH=profiles/freelance.json

# Optional Google Sheets destination. Never commit credentials or live IDs.
TRACKER_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SCOUT_SHEET_SHARE_EMAIL=
SCOUT_JOB_SHEET_TITLE=Hritvik Job Hunt - Scout
SCOUT_JOB_SHEET_ID=
SCOUT_JOB_MAX_RESULTS=100
SCOUT_COMPANY_ENRICH_LIMIT=25
SCOUT_JOB_LOOKBACK_HOURS=336
SCOUT_JOB_CACHE_PATH=.local/job-cache.json

RESEARCH_BATCH_SIZE=10
MAX_NEW_OPPORTUNITIES_PER_DAY=20
SEARCH_PROVIDER=disabled
