NODE_ENV=development
DRY_RUN=true
TIMEZONE=Asia/Kolkata

# Default profile used by your own runner or automation.
# Your search lives in my-search/ (ignored by Git). Override only if needed.
# SCOUT_PROFILE_PATH=my-search/jobs.json
# SCOUT_JOB_SEARCH_PATH=my-search/job-search.json
# SCOUT_ICP_PATH=my-search/job-search-icp.md

# Optional Google Sheets destination. Never commit credentials or live IDs.
TRACKER_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Hosted runs without a key file: the service-account JSON, raw or base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
SCOUT_SHEET_SHARE_EMAIL=
SCOUT_JOB_SHEET_TITLE=Job Hunt - Scout
SCOUT_JOB_SHEET_ID=
SCOUT_JOB_MAX_RESULTS=100
SCOUT_COMPANY_ENRICH_LIMIT=25
SCOUT_JOB_LOOKBACK_HOURS=336
SCOUT_JOB_CACHE_PATH=.local/job-cache.json
SCOUT_BOARD_PROBE_LIMIT=150

RESEARCH_BATCH_SIZE=10
MAX_NEW_OPPORTUNITIES_PER_DAY=20
SEARCH_PROVIDER=disabled
